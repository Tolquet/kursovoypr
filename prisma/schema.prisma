generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String   @db.Text
  image       String?  @db.VarChar(500)
  banner      String?  @db.VarChar(500)
  website     String?  @db.VarChar(500)
  types       String   @db.VarChar(50)
  location    String   @db.VarChar(100)
  city        String?  @db.VarChar(100)
  rating      Float    @default(0)
  tuition     String   @db.VarChar(100)
  minTuition  Float?
  maxTuition  Float?
  categoryIns String[] @default([])
  ownerId     Int?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  reviews     Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  userType  String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company?
  institutes Institute[]
  reviews   Review[]

  @@map("users")
}

model Company {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactPerson String
  companyName   String
  inn           String
  legalAddress  String
  position      String
  phone         String
  department    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("companies")
}

// Модель отзывов и оценок пользователей
model Review {
  id          Int      @id @default(autoincrement())
  userId      Int
  instituteId Int
  rating      Int      // Оценка от 1 до 5
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  // Уникальное ограничение - один отзыв от пользователя на одно заведение
  @@unique([userId, instituteId])
  @@index([instituteId])
  @@index([userId])

  @@map("reviews")
}
